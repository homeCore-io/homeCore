Rule(
    id: "00000000-0000-0000-0000-000000000000",
    name: "Morning, thermostat",
    enabled: true,
    priority: 10,

    trigger: CustomEvent(event_type: "morning_routine_started"),

    actions: [
        RuleAction(action: SetDeviceState(device: "hallway.thermostat", state: { "setpoint": 21 })),   // °C
    ],
)

