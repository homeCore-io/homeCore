# homeCore plugin runtime for Python: ghcr.io/homecore-io/hc-runtime-python
#
# A runtime is a container the operator runs, which hosts any number of
# homeCore plugins written in Python. homeCore never starts or stops it. An
# admin adds it in homeCore (Settings, Plugins, Runtimes), which shows a
# connection key once; paste it into the runtime's page on port 8790, or set it
# as HC_RUNTIME_KEY. homeCore then places plugins on it and the host inside
# installs, runs and supervises them, one process and one virtualenv per
# plugin. See docs/pluginRuntimesPlan.md.
#
# The image is three things:
#
#   hc-runtime-host   static Rust binary, built in the first stage from this
#                     repo. The key, its page, fetching and checking
#                     artifacts, supervision. The same binary for every language.
#   adapter.toml      the only Python-specific part: how to make a venv, install
#                     an artifact offline, and launch a plugin.
#   uv                makes each plugin's venv and installs its wheels into it.
#   Debian (glibc)    because manylinux wheels are what effectively every
#                     package publishes; on musl the long tail turns into source
#                     builds the artifacts refuse to do.
#
# There is no Python here. Each plugin is built for a Python minor and placed
# with an interpreter from the registry (homeCore-io/interpreters), which the
# host fetches through homeCore and keeps in the data volume, one copy per
# version. The image only promises a C library new enough for manylinux_2_28
# wheels (trixie has glibc 2.41), which is what HC_RUNTIME_ABI says. See
# docs/pythonInterpretersPlan.md.
#
# Build from the core repo root:
#
#   docker build -f docker/Dockerfile.runtime-python -t hc-runtime-python .
#
# Run, then open http://<this host>:8790 and paste the key:
#
#   docker run -d --name pyhost-01 -p 8790:8790 \
#     -v pyhost-01:/var/lib/hc-runtime \
#     hc-runtime-python
#
# or skip the page with -e HC_RUNTIME_KEY=hcrt1.… . homeCore's broker has to
# listen on the network; the Runtimes page in homeCore says so and offers to
# change it.

# ── Stage 1: the host ────────────────────────────────────────────────────────
# Same toolchain and target as the released plugins: rust 1.100 on alpine, so
# the binary is static musl and runs on any base below.
FROM rust:1.100-alpine@sha256:8d0e82abfdf9a38071e07cabc5afba4ddbe077631a80e4e742a760c38beadc33 AS host

RUN apk add --no-cache musl-dev pkgconfig

WORKDIR /src
COPY . .

RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release --locked -p hc-runtime-host && \
    cp target/release/hc-runtime-host /hc-runtime-host && \
    strip /hc-runtime-host

# ── Stage 2: the runtime ─────────────────────────────────────────────────────
FROM ghcr.io/astral-sh/uv:0.13.9@sha256:d3b601f0c7b118bc1753febf7c41cc80981df678445e0254284eecf84db79a7d AS uv

FROM debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2

# tini is PID 1: it forwards `docker stop`'s SIGTERM to the host, which stops
# its plugins before exiting, and reaps anything a plugin leaves behind.
# ca-certificates for plugins that call cloud APIs.
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends tini ca-certificates && \
    rm -rf /var/lib/apt/lists/*

COPY --from=host /hc-runtime-host            /usr/local/bin/hc-runtime-host
COPY --from=uv   /uv                         /usr/local/bin/uv
COPY docker/runtime-python/adapter.toml       /etc/hc-runtime/adapter.toml
COPY docker/entrypoint-runtime.sh             /entrypoint.sh

# What this image can host. The host refuses to start if adapter.toml disagrees.
# HC_RUNTIME_ARCH is left to the host, which reports the arch it was built for.
# uv: its cache on the volume, beside the venvs, so plugins that share a wheel
# store it once (hardlinked). It never downloads a Python or reads a config
# file a plugin could have left behind.
ENV HC_RUNTIME_KIND=python \
    HC_RUNTIME_ABI=manylinux_2_28 \
    HC_RUNTIME_DATA=/var/lib/hc-runtime \
    HC_RUNTIME_ADAPTER=/etc/hc-runtime/adapter.toml \
    UV_CACHE_DIR=/var/lib/hc-runtime/uv-cache \
    UV_LINK_MODE=hardlink \
    UV_PYTHON_DOWNLOADS=never \
    UV_NO_CONFIG=1 \
    PYTHONUNBUFFERED=1

# The runtime's own page: paste the key, see what it hosts.
EXPOSE 8790

VOLUME ["/var/lib/hc-runtime"]

ENTRYPOINT ["/usr/bin/tini", "--", "/entrypoint.sh"]
