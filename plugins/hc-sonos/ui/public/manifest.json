{
	"host_api": 1,
	"entry": "index.js",
	"slots": [
		{ "slot": "plugin.page", "element": "hc-sonos-page" },
		{ "slot": "device.panel", "element": "hc-sonos-panel", "device_types": ["media_player"] },
		{ "slot": "device.card", "element": "hc-sonos-card", "device_types": ["media_player"], "forms": ["standard", "large", "compact"] },
		{ "slot": "rule.step", "element": "hc-sonos-step", "device_types": ["media_player"] },
		{
			"slot": "dashboard.card",
			"element": "hc-sonos-speakers",
			"label": "Sonos speakers",
			"description": "every speaker, or the ones you choose: what each plays, its volume, play and pause",
			"forms": ["large", "standard"],
			"settings": "hc-sonos-speakers-settings"
		},
		{
			"slot": "dashboard.card",
			"element": "hc-sonos-favourites",
			"label": "Sonos favourites",
			"description": "your Sonos favourites with their artwork, to play on the speaker you choose",
			"forms": ["large", "standard", "compact"],
			"settings": "hc-sonos-favourites-settings"
		}
	]
}
