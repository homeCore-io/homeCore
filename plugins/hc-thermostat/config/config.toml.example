# hc-thermostat — virtual thermostat plugin.
#
# Copy this file to config.toml and fill in credentials + your thermostats.

[homecore]
plugin_id      = "plugin.thermostat"
broker_host    = "127.0.0.1"
broker_port    = 1883
# Empty password = anonymous (dev broker). For production set a bcrypt hash in
# homecore.toml's [[broker.clients]] entry and the matching plain text here.
password       = ""
heartbeat_secs = 60

[logging]
level              = "info"       # stderr + file filter; RUST_LOG overrides
rotation           = "daily"      # daily | hourly | weekly | never
max_size_mb        = 100          # rotate when active log exceeds N MB (0 = time-only)
compress           = true         # gzip rotated files
prune_after_days   = 5            # delete rotated files older than N days (0 = never)
log_forward_level  = "info"       # minimum level forwarded to HomeCore via MQTT

# ── Thermostats ────────────────────────────────────────────────────────────
#
# One [[thermostat]] per room. Each becomes a `thermostat` device,
# thermostat_<id>. The plugin page's "+ Add a thermostat" writes these for you.
#
# An entry that can't run (a missing field, a target that looks like °F, a
# heater set to cool…) is left out and said on the plugin page; the others run.
#
#   id                   letters, digits, _ and - (it becomes the device id;
#                        never change it)
#   kind                 "ac" | "heater" | "fan" — an AC or a fan cools (Cool,
#                        Off), a heater heats (Heat, Off). Absent: a mode of
#                        "heat" makes it a heater, anything else an AC.
#   sensor_device_ids    devices reporting `temperature` (°C)
#   aggregation          "average" | "min" | "max" across several sensors
#   setpoint             the target, °C (−40…45). 68 °F is 20 °C.
#   hysteresis           the swing, a °C width split either side of the
#                        target: 1.0 switches on 0.5 past it, off 0.5 back
#   mode                 "cool" | "heat" | "off" — Off sends one OFF, then
#                        leaves the switch alone
#   actuator_device_id   the plug or switch it turns on and off
#   min_on_secs          once on, stays on at least this long (AC: 180)
#   min_off_secs         once off, stays off at least this long (AC: 300)
#   max_run_secs         turned off after this long without a break, with an
#                        alert. Absent: 4 h for a heater, no limit otherwise
#   sensor_timeout_secs  a reading older than this no longer counts (7200)
#   on_stale             "off" (default) turns the switch off with no current
#                        reading; "hold" leaves it as it is
#   override_secs        a hand flip of the switch is left alone this long
#                        (3600); 0 takes over again at once
#   actuator_on_cmd      optional custom payloads (default { on = true } /
#   actuator_off_cmd     { on = false }) — only here, never from a command

[[thermostat]]
id                 = "office_ac"
name               = "Office AC Thermostat"
kind               = "ac"
sensor_device_ids  = ["yolink_office_temp"]
aggregation        = "average"
setpoint           = 20.0
hysteresis         = 1.0
mode               = "cool"
actuator_device_id = "zwave_office_ac_outlet"
min_on_secs        = 180
min_off_secs       = 300

[[thermostat]]
id                 = "garage_heater"
name               = "Garage Heater Thermostat"
kind               = "heater"
sensor_device_ids  = ["yolink_garage_temp"]
setpoint           = 7.0
hysteresis         = 1.0
mode               = "heat"
actuator_device_id = "zwave_garage_heater_plug"
min_on_secs        = 120
min_off_secs       = 120
max_run_secs       = 14400
